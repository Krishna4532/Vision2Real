# Vision2Real AI Engine – Production Environment Configuration Example
# Copy or set these environment variables in your production deployment platform (e.g., Render / Railway / AWS).
# IMPORTANT: Never commit actual secret keys, API keys, or passwords to git.

VISION2REAL_ENVIRONMENT=production
VISION2REAL_DEBUG=false
VISION2REAL_SECRET_KEY=your-production-secret-key-change-me

# PostgreSQL Production Database Endpoint
VISION2REAL_DATABASE_URL=postgresql+asyncpg://user:password@your-db-host.postgres.database.azure.com:5432/vision2real
VISION2REAL_DATABASE_URL_SYNC=postgresql+psycopg://user:password@your-db-host.postgres.database.azure.com:5432/vision2real
VISION2REAL_DATABASE_ECHO=false

# Authentication & JWT Security
VISION2REAL_JWT_SECRET_KEY=your-production-jwt-secret-key-min-32-chars
VISION2REAL_JWT_ALGORITHM=HS256
VISION2REAL_ACCESS_TOKEN_EXPIRE_MINUTES=60
VISION2REAL_REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Allowed Origins (Comma separated)
VISION2REAL_ALLOWED_ORIGINS=https://vision2real.in,https://www.vision2real.in,https://vision2real.vercel.app,http://localhost:5173

# LLM Provider Configuration
VISION2REAL_EXECUTION_MODE=v1
VISION2REAL_LLM_PROVIDER=auto
VISION2REAL_GEMINI_API_KEY=your-gemini-api-key
VISION2REAL_OPENROUTER_API_KEY=your-openrouter-api-key
VISION2REAL_GROQ_API_KEY=your-groq-api-key

# Research Provider
VISION2REAL_RESEARCH_PROVIDER=tavily
VISION2REAL_TAVILY_API_KEY=your-tavily-api-key

# Initial Super Admin Bootstrap (Run once during first startup)
VISION2REAL_ADMIN_BOOTSTRAP_EMAIL=admin@vision2real.in
VISION2REAL_ADMIN_BOOTSTRAP_PASSWORD=your-secure-admin-password
