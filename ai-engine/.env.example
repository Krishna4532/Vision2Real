# NOTE: All variables are read with the VISION2REAL_ prefix (see app/core/config.py
# Settings.model_config env_prefix). Variable names below match the Settings field
# names exactly - e.g. VISION2REAL_DATABASE_URL sets Settings.database_url.
VISION2REAL_ENVIRONMENT=development
VISION2REAL_DEBUG=true
VISION2REAL_SECRET_KEY=change-me
VISION2REAL_DATABASE_URL=postgresql+asyncpg://vision2real:vision2real@localhost:5432/vision2real
VISION2REAL_DATABASE_URL_SYNC=postgresql+psycopg://vision2real:vision2real@localhost:5432/vision2real
VISION2REAL_DATABASE_ECHO=false

# LLM provider abstraction (see app/services/llm_provider.py get_llm_provider()).
# "mock" requires no key and runs fully offline. Add a real provider behind
# BaseLLMProvider and extend get_llm_provider() before setting this to anything else.
VISION2REAL_LLM_PROVIDER=mock
VISION2REAL_LLM_MODEL=mock-gpt-4o-mini

# Search/retrieval provider abstraction for the Research agent (see
# app/services/research_provider.py get_research_provider()). "mock" is the only
# implementation wired up in Phase 2 and returns deterministic, clearly-labeled
# fictional results for testing - see MockResearchProvider docstring.
VISION2REAL_RESEARCH_PROVIDER=mock

VISION2REAL_ALLOWED_ORIGINS=http://localhost:3000