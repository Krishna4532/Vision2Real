# NOTE: All variables are read with the VISION2REAL_ prefix (see app/core/config.py
# Settings.model_config env_prefix). Variable names below match the Settings field
# names element - e.g. VISION2REAL_DATABASE_URL sets Settings.database_url.

VISION2REAL_ENVIRONMENT=development
VISION2REAL_DEBUG=true
VISION2REAL_SECRET_KEY=change-me

# PostgreSQL Production & Development Database Configuration
VISION2REAL_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vision2real
VISION2REAL_DATABASE_URL_SYNC=postgresql+psycopg://postgres:postgres@localhost:5432/vision2real
VISION2REAL_DATABASE_ECHO=false

# Authentication & JWT Configuration
VISION2REAL_JWT_SECRET_KEY=vision2real-super-secret-jwt-key-change-in-production-2026
VISION2REAL_JWT_ALGORITHM=HS256
VISION2REAL_ACCESS_TOKEN_EXPIRE_MINUTES=60
VISION2REAL_REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth Integration
VISION2REAL_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# LLM provider abstraction (see app/services/llm_provider.py get_llm_provider()).
VISION2REAL_LLM_PROVIDER=mock
VISION2REAL_LLM_MODEL=mock-gpt-4o-mini

# Execution Mode
# "v1" = single master LLM call (MVP default)
# "v2" = full multi-agent pipeline (future; switch without code changes)
VISION2REAL_EXECUTION_MODE=v1

# Search/retrieval provider abstraction for the Research agent
VISION2REAL_RESEARCH_PROVIDER=mock

# CORS Allowed Origins (Comma separated)
VISION2REAL_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://vision2real.in,https://www.vision2real.in,https://vision2real.vercel.app

# Initial Super Admin bootstrap (required in production; never commit real values)
VISION2REAL_ADMIN_BOOTSTRAP_EMAIL=admin@example.com
VISION2REAL_ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-long-random-password